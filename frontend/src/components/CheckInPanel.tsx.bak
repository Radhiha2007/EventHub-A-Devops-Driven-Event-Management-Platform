import { useEffect, useRef, useState, type FormEvent } from 'react'
import { useMutation, useQueryClient } from '@tanstack/react-query'
import { api } from '@/api/endpoints'
import { errorMessage } from '@/api/client'
import { formatDateTimeUtc } from '@/lib/format'
import { Button } from './ui/Button'
import { Field } from './ui/Form'
import { Notice } from './ui/States'

// Minimal typing for the (Chromium) BarcodeDetector API, used only as a progressive enhancement.
interface BarcodeDetectorLike {
  detect(source: CanvasImageSource): Promise<{ rawValue: string }[]>
}
declare global {
  interface Window {
    BarcodeDetector?: new (opts: { formats: string[] }) => BarcodeDetectorLike
  }
}

function CameraScanner({ onScan, onClose }: { onScan: (v: string) => void; onClose: () => void }) {
  const video = useRef<HTMLVideoElement>(null)
  const [err, setErr] = useState<string | null>(null)
  const onScanRef = useRef(onScan)
  useEffect(() => {
    onScanRef.current = onScan
  })

  useEffect(() => {
    let stream: MediaStream | null = null
    let raf = 0
    let stopped = false
    ;(async () => {
      try {
        const detector = new window.BarcodeDetector!({ formats: ['qr_code'] })
        stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'environment' } })
        if (stopped || !video.current) return
        video.current.srcObject = stream
        await video.current.play()
        const tick = async () => {
          if (stopped || !video.current) return
          try {
            const codes = await detector.detect(video.current)
            if (codes[0]?.rawValue) {
              onScanRef.current(codes[0].rawValue)
              return
            }
          } catch {
            /* frame not ready yet */
          }
          raf = requestAnimationFrame(() => void tick())
        }
        void tick()
      } catch (e) {
        setErr(e instanceof Error ? e.message : 'Could not open the camera.')
      }
    })()
    return () => {
      stopped = true
      cancelAnimationFrame(raf)
      stream?.getTracks().forEach((t) => t.stop())
    }
  }, [])

  return (
    <div className="space-y-2">
      {err ? <Notice tone="error">{err}</Notice> : <video ref={video} muted playsInline className="w-full max-w-sm rounded-xl bg-charcoal" aria-label="Camera preview" />}
      <Button variant="outline" size="sm" onClick={onClose}>Close camera</Button>
    </div>
  )
}

/** Checks an attendee in by QR credential via POST /api/attendance/check-in. */
export function CheckInPanel({ onCheckedIn }: { onCheckedIn?: () => void }) {
  const qc = useQueryClient()
  const [credential, setCredential] = useState('')
  const [camera, setCamera] = useState(false)
  const [localErr, setLocalErr] = useState<string | null>(null)

  const mutation = useMutation({
    mutationFn: (c: string) => api.checkIn(c),
    onSuccess: () => {
      setCredential('')
      void qc.invalidateQueries({ queryKey: ['registrations'] })
      void qc.invalidateQueries({ queryKey: ['my-registrations'] })
      onCheckedIn?.()
    },
  })

  const run = (value: string) => {
    const v = value.trim()
    // CheckInRequest.credential: 32–128 characters
    if (v.length < 32 || v.length > 128) {
      setLocalErr('A credential is 32–128 characters. Scan the attendee’s QR code or paste the full code.')
      return
    }
    setLocalErr(null)
    mutation.mutate(v)
  }
  const submit = (e: FormEvent) => {
    e.preventDefault()
    run(credential)
  }
  const supportsCamera = typeof window !== 'undefined' && 'BarcodeDetector' in window && !!navigator.mediaDevices

  return (
    <div className="space-y-4">
      <form onSubmit={submit} className="space-y-3" noValidate>
        <Field label="QR credential" error={localErr ?? undefined} hint="Scan the QR (camera or a handheld scanner), or paste the code shown under it.">
          <input
            className="input font-mono"
            autoComplete="off"
            spellCheck={false}
            value={credential}
            onChange={(e) => setCredential(e.target.value)}
          />
        </Field>
        <div className="flex flex-wrap gap-2">
          <Button type="submit" variant="green" loading={mutation.isPending} disabled={!credential.trim()}>Check in</Button>
          {!supportsCamera && <p className="w-full text-xs text-ink-soft">Camera scanning isn't supported in this browser (use Chrome/Edge/Android), but a handheld scanner or pasting the code works.</p>}
          {supportsCamera && !camera && <Button variant="outline" onClick={() => setCamera(true)}>Scan with camera</Button>}
        </div>
      </form>
      {camera && (
        <CameraScanner
          onClose={() => setCamera(false)}
          onScan={(v) => {
            setCamera(false)
            setCredential(v)
            run(v)
          }}
        />
      )}
      {mutation.isError && <Notice tone="error">{errorMessage(mutation.error)}</Notice>}
      {mutation.isSuccess && (
        <Notice tone="success" title={`${mutation.data.attendee_name} is checked in ✓`}>
          Recorded at {formatDateTimeUtc(mutation.data.checked_in_at)}.
        </Notice>
      )}
    </div>
  )
}

# PostgreSQL
POSTGRES_DB=eventhub
POSTGRES_USER=eventhub_user
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Application ports
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Microsoft Entra ID
ENTRA_TENANT_ID=your-tenant-id
ENTRA_API_CLIENT_ID=your-api-client-id
VITE_ENTRA_SPA_CLIENT_ID=your-spa-client-id
VITE_ENTRA_TENANT_ID=common

# Backend CORS - comma-separated origins
CORS_ORIGINS=http://localhost:5173

# Optional background task configuration
# REDIS_URL defaults to redis://redis:6379/0
# CELERY_TASK_ALWAYS_EAGER defaults to false
